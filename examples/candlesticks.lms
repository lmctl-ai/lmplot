# Demo candlesticks.dem: candlestick and box-and-whisker plots.
out = ARGV.len() > 0 ? ARGV[0] : "build/candlesticks.dslb";
mkdir("images");
mkdir("build");
if (!file_exists("examples/data/candlesticks.dat")) {
  mkdir("examples/data");
  write_file("examples/data/candlesticks.dat", http_get("https://raw.githubusercontent.com/lmctl-ai/lmplot/main/examples/data/candlesticks.dat"));
}
p = _lmcode_ cli="lmplot" install="github:lmctl-ai/lmplot@latest";
plot.script("set xrange [0:11]\nset yrange [0:10]\nset boxwidth 0.2");
# Image 1: open/close states, hollow when open < close.
plot.png("images/candlesticks-1.png", 800, 600);
plot.cmd("set style fill empty");
plot.cmd("set title 'candlesticks showing both states of open/close'");
plot.cmd("plot 'examples/data/candlesticks.dat' using 1:(int($0)%3?$3:$5):2:6:(int($0)%3?$5:$3) with candlesticks title 'open < close', NaN with boxes lt 1 fs solid 1 title 'close < open'");
plot.close();
# Image 2: box-and-whisker with median bar and whisker bars.
plot.png("images/candlesticks-2.png", 800, 600);
plot.cmd("set style fill empty");
plot.cmd("set title 'box-and-whisker with median bar and whiskerbars'");
plot.cmd("plot 'examples/data/candlesticks.dat' using 1:3:2:6:5 with candlesticks lt 3 lw 2 title 'Quartiles' whiskerbars, '' using 1:4:4:4:4 with candlesticks lt -1 lw 2 notitle");
plot.close();
end _lmcode_
savedsl(p, out);
r = system ${dsl_cli(p)} --lmcode ${out};
assert(r.code == 0);
cp = system cp images/candlesticks-1.png images/candlesticks.png;
assert(cp.code == 0);
println("wrote images/candlesticks.png (and images/candlesticks-1.png .. images/candlesticks-2.png)");
