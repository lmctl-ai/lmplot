# Rocket nozzle, geometry and flow on one axis (lmcad + lmplot).
# 1. lmcad revolves a de Laval nozzle (inner wall r(x), 3.5 mm wall, inlet flange, copper
#    cooling band at the throat), cuts away the front half and renders the section with a
#    narrow, distant camera so 1 pixel = 120/738 mm. The render is written as PPM.
# 2. lmplot solves the quasi-1D isentropic area-Mach relation A(x)/A* for gamma = 9/7
#    (subsonic branch before the throat, supersonic after) and draws Mach number, P/P0 and
#    T/T0 under the section, on the same millimetre axis. The analytic wall r(x) is drawn
#    over the render, so geometry and flow can be checked against each other.
# Writes images/nozzle_cad_plot.png (900x880).
out = ARGV.len() > 0 ? ARGV[0] : "build/nozzle_flow.dslb";
mkdir("images");
mkdir("build/examples");

cad = _lmcode_ cli="lmcad" install="github:lmctl-ai/lmcad@latest";
scene.background(0.97, 0.98, 0.99);
scene.supersample(2);
scene.ambient(0.30);
scene.directional_light(-0.35, -0.45, -0.82, 1.1);
scene.fill_light(0.55, 0.30, -0.60, 0.45);

let alloy = material().color(0.22, 0.47, 0.78).specular(0.5).shininess(32.0);
let copper = material().color(0.86, 0.47, 0.22).specular(0.6).shininess(40.0);

# Inner wall radius (mm) at axial position x in [0, 110]; throat r* = 11 mm at x = 40.
fn wall(x: float) -> float {
  let r = 0.0;
  if (x <= 40.0) {
    let u = (40.0 - x) / 40.0;
    r = 11.0 + 11.0 * u * u * (1.2 - 0.2 * u);
  } else {
    let v = (x - 40.0) / 70.0;
    r = 11.0 + 16.0 * v * v * (2.0 - v);
  }
  return r;
}

# Section revolved about Y (y = x - 55): inner wall forward, outer wall back.
let sk = scene.sketch();
for (i in range(0, 23)) {
  let x = 5.0 * float(i);
  sk.point(wall(x), x - 55.0);
}
sk.point(wall(110.0) + 3.5, 55.0);
for (i in range(0, 21)) {
  let x = 105.0 - 5.0 * float(i);
  sk.point(wall(x) + 3.5, x - 55.0);
}
sk.point(wall(0.0) + 9.0, -49.0);
sk.point(wall(0.0) + 9.0, -55.0);
sk.close();
let body = scene.revolve_y(sk, alloy);

# Copper regenerative-cooling band around the throat, x in [32, 48].
let band_sk = scene.sketch();
band_sk.point(15.3, -23.0);
band_sk.point(19.5, -23.0);
band_sk.point(19.5, -7.0);
band_sk.point(15.3, -7.0);
band_sk.close();
let band_full = scene.revolve_y(band_sk, copper);

# Remove the front half (z > 0) and turn the axis horizontal (inlet on the left).
let cutter = scene.box(140.0, 160.0, 80.0, copper).translate(0.0, 0.0, 40.0);
let nozzle = body.cut(cutter).rotate(0.0, 0.0, 0.0 - 1.5707963267948966);
let band = band_full.cut(cutter).rotate(0.0, 0.0, 0.0 - 1.5707963267948966);
cutter.visible(false);

# Narrow field of view from far away: 70 mm of height over 431 pixels at the cut plane.
scene.camera(4.0, 0.0, 0.0, 1002.3, 0.0, 0.0, 0.0);
scene.render_ppm("build/examples/nozzle_cad.ppm", 738, 431);
end _lmcode_
savedsl(cad, "build/nozzle_cad.dslb");
r = system ${dsl_cli(cad)} --dsl build/nozzle_cad.dslb;
assert(r.code == 0);

p = _lmcode_ cli="lmplot" install="github:lmctl-ai/lmplot@latest";

fn wall(x: float) -> float {
  let r = 0.0;
  if (x <= 40.0) {
    let u = (40.0 - x) / 40.0;
    r = 11.0 + 11.0 * u * u * (1.2 - 0.2 * u);
  } else {
    let v = (x - 40.0) / 70.0;
    r = 11.0 + 16.0 * v * v * (2.0 - v);
  }
  return r;
}

# gamma = 9/7: A/A* = ((1 + M^2/7) / (8/7))^4 / M, T/T0 = 1/(1 + M^2/7), P/P0 = (T/T0)^4.5.
let rows = "";
for (i in range(0, 221)) {
  let x = 0.5 * float(i);
  let rr = wall(x) / 11.0;
  let area_ratio = rr * rr;
  let m_lo = 0.02;
  let m_hi = 1.0;
  if (x > 40.0) {
    m_lo = 1.0;
    m_hi = 5.0;
  }
  for (it in range(0, 50)) {
    let m_mid = 0.5 * (m_lo + m_hi);
    let term = (7.0 + m_mid * m_mid) / 8.0;
    let f_ar = term * term * term * term / m_mid;
    let go_up = f_ar > area_ratio;
    if (x > 40.0) { go_up = f_ar < area_ratio; }
    if (go_up) { m_lo = m_mid; } else { m_hi = m_mid; }
  }
  let mach = 0.5 * (m_lo + m_hi);
  let t_ratio = 7.0 / (7.0 + mach * mach);
  let p_ratio = pow(t_ratio, 4.5);
  rows = rows + str(x) + " " + str(wall(x)) + " " + str(area_ratio) + " " + str(mach) + " " + str(p_ratio) + " " + str(t_ratio) + "\n";
}
plot.data("NOZZLE", rows);

plot.cmd("set terminal unknown");
plot.cmd("stats $NOZZLE using 4 nooutput");
let m_exit = plot.num("STATS_max");
let ar_exit = pow(wall(110.0) / 11.0, 2.0);
let t_exit = 7.0 / (7.0 + m_exit * m_exit);
let p_exit = pow(t_exit, 4.5);
plot.echo("Expansion ratio Ae/A* = " + str(ar_exit));
plot.echo("Exit Mach number Me   = " + str(m_exit));
plot.echo("Exit Pe/P0 = " + str(p_exit) + ", Te/T0 = " + str(t_exit));

plot.png("images/nozzle_cad_plot.png", 900, 880);
plot.cmd("set encoding utf8");
plot.cmd("set multiplot");
plot.cmd("set label 1 'De Laval Nozzle: lmcad Section and Isentropic Flow on One Axis (γ = 9/7)' at screen 0.5, 0.968 center font ',13'");

# Top: the lmcad half-section, placed so that plot x is the axial position in mm.
plot.script("set lmargin at screen 0.09\nset rmargin at screen 0.91\nset tmargin at screen 0.9432\nset bmargin at screen 0.4534");
plot.cmd("set xrange [-5:115]");
plot.cmd("set yrange [-35:35]");
plot.cmd("unset xtics");
plot.cmd("set ytics -30, 10, 30 nomirror font ',9'");
plot.cmd("set ylabel 'radius (mm)'");
plot.cmd("set border 15 lw 1 lc rgb '#cbd5e1'");
plot.cmd("set key at graph 0.99, 0.03 right bottom samplen 2 opaque box lc rgb '#cbd5e1' font ',9'");
plot.cmd("set label 2 sprintf('throat r* = 11 mm\nexit r_e = 27 mm\nA_e / A* = %.2f', " + str(ar_exit) + ") at 46, 32 left front boxed noenhanced font ',9'");
plot.cmd("set label 3 'lmcad: revolved B-rep, front half cut away' at 0, -31 left front font ',9' tc rgb '#475569'");
plot.cmd("plot 'build/examples/nozzle_cad.ppm' binary array=(738,431) skip=15 flipy format='%uchar' dx=0.16260162 dy=0.16241299 origin=(-5,-35) using 1:2:3 with rgbimage notitle, $NOZZLE using 1:2 with lines lw 1.6 dt 2 lc rgb '#facc15' title 'analytic wall r(x) (lmplot)', $NOZZLE using 1:(-$2) with lines lw 1.6 dt 2 lc rgb '#facc15' notitle");
plot.cmd("unset label 2");
plot.cmd("unset label 3");

# Bottom: Mach number and static ratios along the same axis.
plot.script("set lmargin at screen 0.09\nset rmargin at screen 0.91\nset tmargin at screen 0.42\nset bmargin at screen 0.08");
plot.cmd("set border 11 lw 1 lc rgb '#334155'");
plot.cmd("set xtics 0, 10, 110 font ',9'");
plot.cmd("set xlabel 'axial position x (mm)'");
plot.cmd("set ylabel 'Mach number M'");
plot.cmd("set y2label 'P/P_0 , T/T_0' offset -1.5,0");
plot.cmd("set yrange [0:3.6]");
plot.cmd("set y2range [0:1.08]");
plot.cmd("set ytics 0, 0.5, 3.5 nomirror");
plot.cmd("set y2tics 0, 0.2, 1.0 font ',9'");
plot.cmd("set grid xtics ytics lc rgb '#e2e8f0'");
plot.cmd("set arrow 1 from 40, 0 to 40, 3.6 nohead dt 3 lw 1.2 lc rgb '#475569'");
plot.cmd("set arrow 2 from -5, 1 to 115, 1 nohead dt 3 lw 1 lc rgb '#94a3b8'");
plot.cmd("set label 4 'throat, M = 1' at 41, 3.4 left font ',9' tc rgb '#334155'");
plot.cmd("set label 5 sprintf('exit: M_e = %.2f\nP_e/P_0 = %.3f\nT_e/T_0 = %.3f', " + str(m_exit) + ", " + str(p_exit) + ", " + str(t_exit) + ") at 1.5, 1.28 left front boxed noenhanced font ',9'");
plot.cmd("set key at graph 0.02, 0.62 left top Left reverse samplen 2 opaque box lc rgb '#cbd5e1' font ',9'");
plot.cmd("plot $NOZZLE using 1:4 axes x1y1 with lines lw 2.8 lc rgb '#dc2626' title 'Mach number', $NOZZLE using 1:5 axes x1y2 with lines lw 2.3 lc rgb '#1d4ed8' title 'P/P_0 (right axis)', $NOZZLE using 1:6 axes x1y2 with lines lw 2.2 dt 4 lc rgb '#059669' title 'T/T_0 (right axis)'");
plot.cmd("unset multiplot");
plot.close();
end _lmcode_
savedsl(p, out);
r = system ${dsl_cli(p)} --dsl ${out};
assert(r.code == 0);
println("wrote images/nozzle_cad_plot.png");
