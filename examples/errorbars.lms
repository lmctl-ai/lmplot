# Demo errorbars.dem: x/y error bars on the battery.dat measurements vs. a theory curve.
out = ARGV.len() > 0 ? ARGV[0] : "build/errorbars.dslb";
mkdir("build/examples");
p = _dsl_ cli="lmplot" install="github:lmctl-ai/lmplot@latest";
plot.script("set xlabel 'Resistance [Ohm]'\nset ylabel 'Power [W]'\nn(x)=1.53**2*x/(5.67+x)**2");
# Image 1: both x and y errors.
plot.png("build/examples/errorbars-1.png", 800, 600);
plot.cmd("set title 'error represented by xyerrorbars'");
plot.cmd("plot [0:50] 'examples/data/battery.dat' t 'Power' with xyerrorbars, n(x) t 'Theory' w lines");
plot.close();
# Image 2: boxes instead of bars.
plot.png("build/examples/errorbars-2.png", 800, 600);
plot.cmd("set title 'error represented by boxxyerror'");
plot.cmd("plot [0:50] 'examples/data/battery.dat' t 'Power' with boxxyerr, n(x) t 'Theory' w lines");
plot.close();
# Image 3: y errors only, log scaled y axis, small bar ends.
plot.png("build/examples/errorbars-3.png", 800, 600);
plot.script("set logscale y\nset bars small");
plot.cmd("set title 'yerrorbars in log scale, small bars'");
plot.cmd("plot [0:50] 'examples/data/battery.dat' u 1:2:4 t 'Power' w yerr, n(x) t 'Theory' w lines");
plot.close();
end _dsl_
savedsl(p, out);
println(f"wrote {out}");
