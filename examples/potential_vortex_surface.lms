# Ginzburg-Landau double-well free-energy surface F(qx, qy) with symmetry-breaking
# tilt, saddle-point transition path, and projected contours.
# Writes build/examples/potential_vortex_surface.png (900x600).
out = ARGV.len() > 0 ? ARGV[0] : "build/potential_vortex_surface.dslb";
mkdir("build/examples");
p = _dsl_ cli="lmplot" install="github:lmctl-ai/lmplot@latest";

# Landau free energy: F(x, y) = 0.25*(x^2 - 1.44)^2 + 0.55*y^2 - 0.12*x + 0.08*x*y^2 + 0.85
# Sample the minimum-energy transition path along y = 0 for x in [-1.35, 1.35]
let path_rows = "";
for (i in range(0, 61)) {
  let x = -1.35 + 2.70 * float(i) / 60.0;
  let y = 0.0;
  let d = x * x - 1.44;
  let fval = 0.25 * d * d + 0.55 * y * y - 0.12 * x + 0.85;
  path_rows = path_rows + str(x) + " " + str(y) + " " + str(fval) + "\n";
}
plot.data("PATH", path_rows);

plot.cmd("set terminal unknown");
plot.cmd("stats $PATH using 1:3 nooutput");
let f_min = plot.num("STATS_min_y");
let f_saddle = 0.25 * 1.44 * 1.44 + 0.85;
let barrier = f_saddle - f_min;
plot.echo("global minimum F_min = " + str(f_min) + " k_B T");
plot.echo("saddle barrier dF    = " + str(barrier) + " k_B T");

plot.png("build/examples/potential_vortex_surface.png", 900, 600);
plot.cmd("set encoding utf8");
plot.cmd("set title 'Ginzburg-Landau Free-Energy Landscape F(q_x, q_y) — Bistable Phase-Transition Barrier' font ',12'");
plot.cmd("set xlabel 'Order Parameter q_x' offset -2,-1.3");
plot.cmd("set ylabel 'Transverse Mode q_y' offset 3,-1.3");
plot.cmd("set zlabel 'Free Energy F / k_B T' rotate by 90 offset -1.5,0");
plot.cmd("set xrange [-1.85:1.85]");
plot.cmd("set yrange [-1.65:1.65]");
plot.cmd("set zrange [0:2.6]");
plot.cmd("set cbrange [0.5:2.4]");
plot.cmd("set cblabel 'F(q_x, q_y) [k_B T]' offset -0.5,0");
plot.cmd("set view 56, 38, 0.96, 1.0");
plot.cmd("set xyplane at 0.0");
plot.cmd("set samples 42, 42");
plot.cmd("set isosamples 34, 34");
plot.cmd("set pm3d at bs depthorder border lc rgb '#1e293b' lw 0.2");
plot.cmd("set contour base");
plot.cmd("set cntrparam levels incremental 0.65, 0.20, 2.25");
plot.cmd("unset clabel");
plot.cmd("set palette defined (0 '#0f172a', 0.22 '#1d4ed8', 0.48 '#06b6d4', 0.72 '#f59e0b', 1 '#dc2626')");
plot.cmd("set key top right samplen 2.0 opaque box lc rgb '#cbd5e1'");

let info = plot.str("sprintf('Global minimum: q_x = +1.22 (F = %.2f k_B T)\nMetastable well: q_x = -1.18 (ΔF = +0.29 k_B T)\nActivation barrier: ΔF‡ = %.2f k_B T at q = (0, 0)', " + str(f_min) + ", " + str(barrier) + ")");
plot.cmd("set label 1 '" + info + "' at screen 0.03, 0.88 left front boxed noenhanced font ',9.5'");

plot.cmd("F(x,y) = 0.25*(x**2 - 1.44)**2 + 0.55*y**2 - 0.12*x + 0.08*x*y**2 + 0.85");
plot.cmd("splot F(x,y) with pm3d title 'Landau surface F(q_x, q_y)', $PATH using 1:2:(0.02) with lines lw 3.2 lc rgb '#ffffff' nocontour notitle, $PATH using 1:2:(0.02) with lines lw 2.2 lc rgb '#e11d48' nocontour title 'Minimum-energy transition pathway (y = 0)'");
plot.close();
end _dsl_
savedsl(p, out);
if (ARGV.len() == 0) {
  r = system ${dsl_cli(p)} --dsl ${out};
  assert(r.code == 0);
}
println(f"wrote {out}");
