# Video: a standing-wave displacement field on a unit membrane, two superposed modes with
# different frequencies, drawn as a heat map (pm3d map view) over 40 frames at 10 fps.
#   u(x, y, t) = sin(2 pi x) sin(pi y) cos(w1 t) + 0.6 sin(3 pi x) sin(2 pi y) cos(w2 t)
# with w_mn = pi sqrt(m^2 + n^2) for a membrane with unit wave speed. The frames are
# generated by gnuplot from the function itself (no data per frame); the program checks
# the mode frequencies and that u vanishes on all four edges (checked at sample times).
# `lmscript examples/video/standing_wave.lms` writes images/standing_wave.mp4 and
# images/standing_wave.png (frame 12).
mkdir("images");
mkdir("build/video/standing_wave");
out = ARGV.len() > 0 ? ARGV[0] : "build/video/standing_wave.dslb";

p = _dsl_ cli="lmplot" install="github:lmctl-ai/lmplot@latest";
let frames = 40;
# One period of the slower mode is 2 pi / w1; the animation covers 1.5 of those periods.
let period = 6.283185307179586 / (3.141592653589793 * 2.236067977499790);
plot.cmd("set encoding utf8");
plot.cmd("set xrange [0:1]");
plot.cmd("set yrange [0:1]");
plot.cmd("set isosamples 90,90");
plot.cmd("set view map");
plot.cmd("set pm3d map");
plot.cmd("unset key");
plot.cmd("set palette defined (0 '#1e3a8a', 0.5 '#f8fafc', 1 '#9a3412')");
plot.cmd("set cbrange [-1.6:1.6]");
plot.cmd("set cblabel 'u(x, y, t)'");
plot.cmd("set xlabel 'x'");
plot.cmd("set ylabel 'y'");
plot.cmd("set size ratio -1");
plot.cmd("w1 = pi * sqrt(5.0)");
plot.cmd("w2 = pi * sqrt(13.0)");
plot.cmd("u(x, y, t) = sin(2*pi*x)*sin(pi*y)*cos(w1*t) + 0.6*sin(3*pi*x)*sin(2*pi*y)*cos(w2*t)");
# Known answers: the mode frequencies, and u = 0 on the four edges at a sample of times.
plot.assert_close(plot.num("w1*w1"), 5.0 * 3.141592653589793 * 3.141592653589793, 0.000000001);
plot.assert_close(plot.num("w2*w2"), 13.0 * 3.141592653589793 * 3.141592653589793, 0.000000001);
plot.assert_close(plot.num("u(0.0, 0.3, 0.7)"), 0.0, 0.000000001);
plot.assert_close(plot.num("u(1.0, 0.3, 0.7)"), 0.0, 0.000000001);
plot.assert_close(plot.num("u(0.4, 0.0, 0.7)"), 0.0, 0.000000001);
plot.assert_close(plot.num("u(0.4, 1.0, 0.7)"), 0.0, 0.000000001);

for (k in range(0, frames)) {
  let t = period * 1.5 * float(k) / float(frames);
  plot.png("build/video/standing_wave/frame-" + str(k) + ".png", 800, 640);
  plot.cmd("set title sprintf('Standing waves on a membrane, t = %.3f', " + str(t) + ")");
  plot.cmd("splot u(x, y, " + str(t) + ") with pm3d");
  plot.close();
}
end _dsl_
savedsl(p, out);
r = system ${dsl_cli(p)} --dsl ${out};
assert(r.code == 0);
r = system ffmpeg -y -loglevel error -framerate 10 -i build/video/standing_wave/frame-%d.png -c:v libx264 -pix_fmt yuv420p images/standing_wave.mp4;
assert(r.code == 0);
cp = system cp build/video/standing_wave/frame-12.png images/standing_wave.png;
assert(cp.code == 0);
println("wrote images/standing_wave.mp4 and images/standing_wave.png");
