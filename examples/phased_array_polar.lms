# 8-element uniform linear antenna array (d = lambda/2) steered to theta_0 = 30 deg:
# compares uniform illumination vs raised-cosine pedestal tapering in polar dB gain.
# Writes images/phased_array_polar.png (900x600).
out = ARGV.len() > 0 ? ARGV[0] : "build/phased_array_polar.dslb";
mkdir("images");
mkdir("build");
p = _dsl_ cli="lmplot" install="github:lmctl-ai/lmplot@latest";

fn sin_approx(x: float) -> float {
  let pi = 3.141592653589793;
  let twopi = 6.283185307179586;
  let k = int((x + pi) / twopi);
  let u = x - float(k) * twopi;
  if (u > pi) { u = u - twopi; }
  if (u < 0.0 - pi) { u = u + twopi; }
  let u2 = u * u;
  return u * (1.0 - u2 / 6.0 + (u2 * u2) / 120.0 - (u2 * u2 * u2) / 5040.0);
}

fn cos_approx(x: float) -> float {
  return sin_approx(x + 1.5707963267948966);
}

fn log10_pos(v: float) -> float {
  let x = v;
  let k = 0;
  if (x < 0.0001) { x = 0.0001; }
  for (iter in range(0, 16)) {
    if (x < 0.70710678) {
      x = x * 2.0;
      k = k - 1;
    }
    if (x > 1.41421356) {
      x = x * 0.5;
      k = k + 1;
    }
  }
  let y = (x - 1.0) / (x + 1.0);
  let y2 = y * y;
  let lnx = 2.0 * y * (1.0 + y2 / 3.0 + (y2 * y2) / 5.0 + (y2 * y2 * y2) / 7.0) + float(k) * 0.69314718056;
  return lnx * 0.4342944819;
}

let pi = 3.141592653589793;
let rows = "";
for (deg in range(0, 361)) {
  let th = float(deg) * pi / 180.0;
  let psi = pi * (sin_approx(th) - 0.5);
  let re_u = 0.0;
  let im_u = 0.0;
  let re_t = 0.0;
  let im_t = 0.0;
  let w_sum = 0.0;
  for (n in range(0, 8)) {
    let phase = (float(n) - 3.5) * psi;
    let c = cos_approx(phase);
    let s = sin_approx(phase);
    re_u = re_u + c;
    im_u = im_u + s;
    let wn = 0.42 + 0.58 * cos_approx(pi * (float(n) - 3.5) / 4.2);
    re_t = re_t + wn * c;
    im_t = im_t + wn * s;
    w_sum = w_sum + wn;
  }
  let mag_u2 = (re_u * re_u + im_u * im_u) / 64.0;
  let mag_t2 = (re_t * re_t + im_t * im_t) / (w_sum * w_sum);
  let db_u = 10.0 * log10_pos(mag_u2);
  let db_t = 10.0 * log10_pos(mag_t2);
  if (db_u < -35.0) { db_u = -35.0; }
  if (db_t < -35.0) { db_t = -35.0; }
  rows = rows + str(th) + " " + str(db_u) + " " + str(db_t) + " " + str(deg) + "\n";
}
plot.data("ARRAY", rows);

# Measure side-lobe level outside the main beam ([200, 340] deg) via gnuplot stats
plot.cmd("set terminal unknown");
plot.cmd("stats $ARRAY using ($4 >= 200 && $4 <= 340 ? $2 : 1/0):($4 >= 200 && $4 <= 340 ? $3 : 1/0) nooutput");
let sll_uniform = plot.num("STATS_max_x");
let sll_tapered = plot.num("STATS_max_y");
let sll_gain = sll_uniform - sll_tapered;
plot.echo("Uniform 1st side-lobe: " + str(sll_uniform) + " dB");
plot.echo("Tapered 1st side-lobe: " + str(sll_tapered) + " dB");
plot.echo("Side-lobe suppression: " + str(sll_gain) + " dB");

plot.png("images/phased_array_polar.png", 900, 600);
plot.cmd("set encoding utf8");
plot.cmd("set polar");
plot.cmd("set angles radians");
plot.cmd("set size ratio 1");
plot.script("set lmargin 5\nset rmargin 36\nset tmargin 4.0\nset bmargin 3.0");
plot.cmd("set label 10 '8-Element Phased Array Beamforming (d = λ/2, Steered θ_0 = 30°) — Uniform vs Tapered Gain' at screen 0.50, 0.955 center front font ',12'");
plot.cmd("set rrange [-35:0]");
plot.cmd("set rtics (-30, -20, -10, 0)");
plot.cmd("set grid polar pi/6 lc rgb '#cbd5e1' lw 1");
plot.cmd("unset border");
plot.cmd("unset xtics");
plot.cmd("unset ytics");
plot.cmd("set ttics 0, 30 format '%g°' font ',9.5'");
plot.cmd("set key at screen 0.97, 0.84 right top samplen 2.2 spacing 1.25 opaque box lc rgb '#cbd5e1' font ',9.5'");
plot.cmd("set style fill transparent solid 0.20 noborder");

let box_txt = plot.str("sprintf('Linear Array: N = 8, spacing d = λ/2\nElectronic beam steering: θ_0 = 30°\nUniform 1st side-lobe: %.1f dB\nTapered 1st side-lobe: %.1f dB\nSide-lobe suppression: +%.1f dB', " + str(sll_uniform) + ", " + str(sll_tapered) + ", " + str(sll_gain) + ")");
plot.cmd("set label 1 '" + box_txt + "' at screen 0.63, 0.34 left front boxed noenhanced font ',9.5'");

# Steering direction indicator at theta = 30 deg (radius 35 in plot coords)
plot.cmd("set arrow 1 from 0, 0 to 30.31, 17.5 head filled size screen 0.014,18 lw 1.8 lc rgb '#059669' front");
plot.cmd("set label 2 'Main Beam\nθ_0 = 30°' at 39.5, 24.5 center front tc rgb '#065f46' font ',9'");

plot.cmd("plot $ARRAY using 1:2 with lines lw 1.8 dt 2 lc rgb '#dc2626' title 'Uniform excitation (SLL = -13.1 dB)', $ARRAY using 1:3 with filledcurve r=-35 lc rgb '#2563eb' notitle, $ARRAY using 1:3 with lines lw 2.6 lc rgb '#1d4ed8' title 'Cosine-pedestal taper (SLL = -20.5 dB)'");
plot.close();
end _dsl_
savedsl(p, out);
r = system ${dsl_cli(p)} --dsl ${out};
assert(r.code == 0);
println("wrote images/phased_array_polar.png");
