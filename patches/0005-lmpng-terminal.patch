@@ -0,0 +1,1114 @@
+/* Hello, Emacs, this is -*-C-*- */
+
+/* lmplot: native PNG terminal.
+ *
+ * A dependency-free replacement for gnuplot's gd/cairo PNG terminals. Drawing
+ * goes through lmraster (cpp/raster: anti-aliased scanline rasterizer and
+ * embedded DejaVu TrueType fonts), so `set terminal png` and
+ * `set terminal pngcairo` work in a fully static executable.
+ *
+ * Not part of upstream gnuplot. The structure of this driver, in particular
+ * the enhanced-text handling, follows gnuplot's own gd.trm and svg.trm and the
+ * terminal API in term_api.h, so this file is distributed as a patch against
+ * gnuplot (patches/0005-lmpng-terminal.patch) under gnuplot's license terms
+ * (see THIRD_PARTY_NOTICES). The rasterizer it calls is independent MIT code.
+ *
+ * Modified-version notice: lmplot (https://github.com/lmctl-ai/lmplot),
+ * Lattice Systems LLC.
+ */
+
+#include "driver.h"
+
+#ifdef TERM_REGISTER
+register_term(lmpng)
+#endif
+
+#ifdef TERM_PROTO
+TERM_PUBLIC void LMPNG_options(void);
+TERM_PUBLIC void LMPNG_init(void);
+TERM_PUBLIC void LMPNG_reset(void);
+TERM_PUBLIC void LMPNG_text(void);
+TERM_PUBLIC void LMPNG_graphics(void);
+TERM_PUBLIC void LMPNG_move(unsigned int x, unsigned int y);
+TERM_PUBLIC void LMPNG_vector(unsigned int x, unsigned int y);
+TERM_PUBLIC void LMPNG_linetype(int lt);
+TERM_PUBLIC void LMPNG_dashtype(int type, t_dashtype *custom);
+TERM_PUBLIC void LMPNG_linewidth(double lw);
+TERM_PUBLIC int  LMPNG_text_angle(float ang);
+TERM_PUBLIC int  LMPNG_justify_text(enum JUSTIFY mode);
+TERM_PUBLIC void LMPNG_point(unsigned int x, unsigned int y, int number);
+TERM_PUBLIC int  LMPNG_set_font(const char *font);
+TERM_PUBLIC void LMPNG_fillbox(int style, unsigned int x, unsigned int y, unsigned int w, unsigned int h);
+TERM_PUBLIC int  LMPNG_make_palette(t_sm_palette *palette);
+TERM_PUBLIC void LMPNG_set_color(t_colorspec *colorspec);
+TERM_PUBLIC void LMPNG_filled_polygon(int points, gpiPoint *corners);
+TERM_PUBLIC void LMPNG_image(unsigned int m, unsigned int n, coordval *image, gpiPoint *corner, t_imagecolor color_mode);
+TERM_PUBLIC void LMPNG_put_text(unsigned int x, unsigned int y, const char *str);
+TERM_PUBLIC void LMPNG_put_text_plain(unsigned int x, unsigned int y, const char *str);
+TERM_PUBLIC void LMPNG_enhanced_open(char *fontname, double fontsize, double base, TBOOLEAN widthflag, TBOOLEAN showflag, int overprint);
+TERM_PUBLIC void LMPNG_enhanced_flush(void);
+TERM_PUBLIC void LMPNG_boxed_text(unsigned int x, unsigned int y, int option);
+TERM_PUBLIC void LMPNG_layer(t_termlayer layer);
+
+#define LMPNG_XMAX 640
+#define LMPNG_YMAX 480
+#define LMPNG_PX_PER_PT (96.0 / 72.0)
+#endif /* TERM_PROTO */
+
+#ifndef TERM_PROTO_ONLY
+#ifdef TERM_BODY
+
+#include "lmraster.h"
+#include <math.h>
+
+#define LMPNG_MAXPATH 100000
+
+static struct {
+    lmr *img;
+    int width, height;            /* canvas size in pixels */
+    int opt_width, opt_height;
+    unsigned bg;                  /* 0xRRGGBB */
+    int bg_set, transparent, crop;
+    unsigned rgb;                 /* current color 0xRRGGBB */
+    double opacity;               /* 1 = opaque */
+    int lt;                       /* current linetype index */
+    double lw;                    /* current linewidth (gnuplot units) */
+    double lw_factor, dash_factor;
+    int cap_round;                /* 0 butt, 1 rounded, 2 square */
+    double dash[8];
+    int ndash;
+    int axis_dash;
+    double *path;                 /* pending polyline, device coords */
+    int npath, cappath;
+    unsigned lastx, lasty;
+    int have_last;
+    /* text */
+    lmr_font font, default_font;
+    char *fontname, *default_fontname;
+    double fontsize, default_fontsize, fontscale;
+    float angle;
+    enum JUSTIFY just;
+    int enhanced;
+    int monochrome;
+    /* enhanced text machinery */
+    int enh_open, enh_show, enh_overprint, enh_widthflag, enh_sizeonly;
+    char *enh_font;
+    double enh_size, enh_base;
+    double pen_x, pen_y, save_x, save_y;
+    double box[4];                /* text bounding box (device), x0,y0,x1,y1 */
+    double box_xmargin, box_ymargin;
+    int box_valid;
+    int crisp;                    /* inside a pm3d layer: seam-free fills */
+} LM;
+
+enum LMPNG_id {
+    LMPNG_SIZE, LMPNG_FONT, LMPNG_FONTSCALE, LMPNG_ENHANCED, LMPNG_NOENHANCED, LMPNG_TRANSPARENT, LMPNG_NOTRANSPARENT,
+    LMPNG_CROP, LMPNG_NOCROP, LMPNG_BACKGROUND, LMPNG_LINEWIDTH, LMPNG_DASHLENGTH, LMPNG_BUTT, LMPNG_ROUNDED, LMPNG_SQUARE,
+    LMPNG_COLOR, LMPNG_MONOCHROME, LMPNG_IGNORED, LMPNG_TINY, LMPNG_SMALL, LMPNG_MEDIUM, LMPNG_LARGE, LMPNG_GIANT,
+    LMPNG_POINTSCALE, LMPNG_OTHER
+};
+
+static struct gen_table LMPNG_opts[] = {
+    { "si$ze", LMPNG_SIZE },
+    { "fo$nt", LMPNG_FONT },
+    { "fontscale", LMPNG_FONTSCALE },
+    { "enh$anced", LMPNG_ENHANCED },
+    { "noenh$anced", LMPNG_NOENHANCED },
+    { "trans$parent", LMPNG_TRANSPARENT },
+    { "notran$sparent", LMPNG_NOTRANSPARENT },
+    { "crop", LMPNG_CROP },
+    { "nocrop", LMPNG_NOCROP },
+    { "backg$round", LMPNG_BACKGROUND },
+    { "linew$idth", LMPNG_LINEWIDTH },
+    { "lw", LMPNG_LINEWIDTH },
+    { "dashl$ength", LMPNG_DASHLENGTH },
+    { "dl", LMPNG_DASHLENGTH },
+    { "butt", LMPNG_BUTT },
+    { "round$ed", LMPNG_ROUNDED },
+    { "square", LMPNG_SQUARE },
+    { "col$or", LMPNG_COLOR },
+    { "colour", LMPNG_COLOR },
+    { "mono$chrome", LMPNG_MONOCHROME },
+    { "true$color", LMPNG_IGNORED },
+    { "notrue$color", LMPNG_IGNORED },
+    { "inter$lace", LMPNG_IGNORED },
+    { "nointer$lace", LMPNG_IGNORED },
+    { "ti$ny", LMPNG_TINY },
+    { "s$mall", LMPNG_SMALL },
+    { "m$edium", LMPNG_MEDIUM },
+    { "l$arge", LMPNG_LARGE },
+    { "g$iant", LMPNG_GIANT },
+    { "pointscale", LMPNG_POINTSCALE },
+    { "ps", LMPNG_POINTSCALE },
+    { NULL, LMPNG_OTHER }
+};
+
+static const char *LMPNG_initialized = NULL;
+
+/* ------------------------------------------------------------ helpers */
+
+/* Terminal coordinates (y up, 0..xmax/ymax inclusive) to device pixel centers. */
+#define LMX(x) ((double)(x) + 0.5)
+#define LMY(y) ((double)(LM.height - 1 - (int)(y)) + 0.5)
+
+static unsigned
+LMPNG_argb(void)
+{
+    unsigned a = (unsigned)(LM.opacity * 255.0 + 0.5);
+    if (a > 255) a = 255;
+    return (a << 24) | (LM.rgb & 0xffffff);
+}
+
+static void
+LMPNG_flush_path(void)
+{
+    if (LM.npath >= 1 && LM.img && LM.lt != LT_NODRAW) {
+        double w = LM.lw * LM.lw_factor;
+        double dash[8];
+        int nd = 0, i;
+        if (w < 0.01) w = 0.01;
+        if (LM.axis_dash) {
+            dash[0] = 2; dash[1] = 4; nd = 2;
+        } else if (LM.ndash) {
+            for (i = 0; i < LM.ndash; i++) dash[i] = LM.dash[i];
+            nd = LM.ndash;
+        }
+        lmr_stroke(LM.img, LM.path, LM.npath, w, LMPNG_argb(), LM.cappath,
+                   LM.cappath == LMR_CAP_ROUND ? LMR_JOIN_ROUND : LMR_JOIN_MITER, dash, nd);
+    }
+    LM.npath = 0;
+}
+
+static void
+LMPNG_path_add(double x, double y)
+{
+    if (!LM.path)
+        LM.path = (double *)gp_alloc(sizeof(double) * 2 * LMPNG_MAXPATH, "lmpng path");
+    if (LM.npath >= LMPNG_MAXPATH) {
+        double lx = LM.path[2 * LM.npath - 2], ly = LM.path[2 * LM.npath - 1];
+        LMPNG_flush_path();
+        LM.path[0] = lx; LM.path[1] = ly; LM.npath = 1;
+    }
+    LM.path[2 * LM.npath] = x;
+    LM.path[2 * LM.npath + 1] = y;
+    LM.npath++;
+}
+
+/* gnuplot's classic pen table (index = linetype + 3 in svg.trm). */
+static unsigned
+LMPNG_pen_rgb(int lt)
+{
+    static const unsigned pens[16] = {
+        0xffffff, 0x000000, 0x808080, 0xff0000, 0x00ff00, 0x0000ff, 0x00ffff, 0x157545,
+        0x000094, 0xff9900, 0x0099a1, 0xd6d645, 0xa391ff, 0xffcc00, 0xd60078, 0xabd600
+    };
+    int idx;
+    if (LM.monochrome && lt >= 0) return 0x000000;
+    if (lt == LT_BACKGROUND) return LM.bg;
+    if (lt >= 13) lt %= 13;
+    idx = lt + 3;
+    if (idx < 0) idx = 0;
+    if (idx > 15) idx = 15;
+    return pens[idx];
+}
+
+static void
+LMPNG_parse_font(const char *font, char **name_out, double *size_out, lmr_font *f, int keep_name)
+{
+    char *copy, *comma, *p;
+    int bold = 0, italic = 0;
+    if (!font) return;
+    copy = gp_strdup(font);
+    comma = strchr(copy, ',');
+    if (comma) {
+        double sz;
+        if (sscanf(comma + 1, "%lf", &sz) == 1 && sz > 0) *size_out = sz;
+        *comma = '\0';
+    }
+    if (*copy == '\0' && keep_name) { free(copy); return; }
+    for (p = copy; *p; p++) *p = (char)tolower((unsigned char)*p);
+    if (strstr(copy, "bold")) bold = 1;
+    if (strstr(copy, "italic") || strstr(copy, "oblique")) italic = 1;
+    f->bold = bold;
+    f->italic = italic;
+    if (strstr(copy, "symbol")) f->family = LMR_FAMILY_SYMBOL;
+    else if (strstr(copy, "mono") || strstr(copy, "courier") || strstr(copy, "consol") || strstr(copy, "fixed"))
+        f->family = LMR_FAMILY_MONO;
+    else if ((strstr(copy, "serif") && !strstr(copy, "sans")) || strstr(copy, "times") || strstr(copy, "georgia")
+             || strstr(copy, "palatino") || strstr(copy, "bookman") || strstr(copy, "garamond") || strstr(copy, "century"))
+        f->family = LMR_FAMILY_SERIF;
+    else
+        f->family = LMR_FAMILY_SANS;
+    free(*name_out);
+    /* keep the user's spelling (minus size) for the options string */
+    copy = gp_strdup(font);
+    comma = strchr(copy, ',');
+    if (comma) *comma = '\0';
+    *name_out = copy;
+}
+
+static void
+LMPNG_apply_font_metrics(void)
+{
+    double px = LM.default_fontsize * LM.fontscale * LMPNG_PX_PER_PT;
+    term->h_char = (unsigned int)(px * 0.6 + 0.5);
+    term->v_char = (unsigned int)(px * 1.25 + 0.5);
+    if (term->h_char < 1) term->h_char = 1;
+    if (term->v_char < 1) term->v_char = 1;
+}
+
+static void
+LMPNG_apply_size(void)
+{
+    term->xmax = LM.opt_width - 1;
+    term->ymax = LM.opt_height - 1;
+    term->v_tic = (LM.opt_width < LM.opt_height ? LM.opt_width : LM.opt_height) / 100;
+    if (term->v_tic < 1) term->v_tic = 1;
+    term->h_tic = term->v_tic;
+}
+
+/* ------------------------------------------------------------ options */
+
+TERM_PUBLIC void
+LMPNG_options(void)
+{
+    int fresh = (LMPNG_initialized != term->name);
+    if (fresh) {
+        LMPNG_initialized = term->name;
+        LM.opt_width = LMPNG_XMAX;
+        LM.opt_height = LMPNG_YMAX;
+        LM.bg_set = 0;
+        LM.bg = 0xffffff;
+        LM.transparent = 0;
+        LM.crop = 0;
+        LM.lw_factor = 1.0;
+        LM.dash_factor = 1.0;
+        LM.cap_round = 0;
+        LM.monochrome = 0;
+        LM.fontscale = 1.0;
+        free(LM.default_fontname);
+        LM.default_fontname = gp_strdup("Sans");
+        LM.default_fontsize = 12.0;
+        LM.default_font.family = LMR_FAMILY_SANS;
+        LM.default_font.bold = LM.default_font.italic = 0;
+    }
+    term->flags &= ~TERM_MONOCHROME;
+    term->flags |= TERM_ENHANCED_TEXT;
+    LM.enhanced = 1;
+    term->put_text = LMPNG_put_text;
+
+    while (!END_OF_COMMAND) {
+        switch (lookup_table(&LMPNG_opts[0], c_token)) {
+        case LMPNG_SIZE:
+            c_token++;
+            if (END_OF_COMMAND) {
+                LM.opt_width = LMPNG_XMAX; LM.opt_height = LMPNG_YMAX;
+            } else {
+                double w = real_expression(), h = LM.opt_height;
+                if (equals(c_token, ",")) { c_token++; h = real_expression(); }
+                if (w >= 1 && h >= 1 && w < 30000 && h < 30000 && w * h <= 100000000.0) {
+                    LM.opt_width = (int)w; LM.opt_height = (int)h;
+                } else {
+                    int_error(c_token, "size out of range");
+                }
+            }
+            break;
+        case LMPNG_FONT: {
+            char *s;
+            c_token++;
+            if (END_OF_COMMAND) break;
+            if (isstringvalue(c_token) && (s = try_to_get_string())) {
+                LMPNG_parse_font(s, &LM.default_fontname, &LM.default_fontsize, &LM.default_font, 1);
+                free(s);
+            } else {
+                int_error(c_token, "expecting font name and size in quotes");
+            }
+            break;
+        }
+        case LMPNG_FONTSCALE:
+            c_token++;
+            LM.fontscale = END_OF_COMMAND ? 1.0 : real_expression();
+            if (LM.fontscale <= 0) LM.fontscale = 1.0;
+            break;
+        case LMPNG_ENHANCED: LM.enhanced = 1; c_token++; break;
+        case LMPNG_NOENHANCED: LM.enhanced = 0; c_token++; break;
+        case LMPNG_TRANSPARENT: LM.transparent = 1; c_token++; break;
+        case LMPNG_NOTRANSPARENT: LM.transparent = 0; c_token++; break;
+        case LMPNG_CROP: LM.crop = 1; c_token++; break;
+        case LMPNG_NOCROP: LM.crop = 0; c_token++; break;
+        case LMPNG_BACKGROUND:
+            c_token++;
+            LM.bg = (unsigned)parse_color_name() & 0xffffff;
+            LM.bg_set = 1;
+            break;
+        case LMPNG_LINEWIDTH:
+            c_token++;
+            LM.lw_factor = real_expression();
+            if (LM.lw_factor <= 0) LM.lw_factor = 1.0;
+            break;
+        case LMPNG_DASHLENGTH:
+            c_token++;
+            LM.dash_factor = real_expression();
+            if (LM.dash_factor <= 0.2) LM.dash_factor = 1.0;
+            break;
+        case LMPNG_BUTT: LM.cap_round = 0; c_token++; break;
+        case LMPNG_ROUNDED: LM.cap_round = 1; c_token++; break;
+        case LMPNG_SQUARE: LM.cap_round = 2; c_token++; break;
+        case LMPNG_COLOR: LM.monochrome = 0; c_token++; break;
+        case LMPNG_MONOCHROME: LM.monochrome = 1; c_token++; break;
+        case LMPNG_IGNORED: c_token++; break;
+        case LMPNG_TINY: LM.default_fontsize = 7; c_token++; break;
+        case LMPNG_SMALL: LM.default_fontsize = 9; c_token++; break;
+        case LMPNG_MEDIUM: LM.default_fontsize = 12; c_token++; break;
+        case LMPNG_LARGE: LM.default_fontsize = 14; c_token++; break;
+        case LMPNG_GIANT: LM.default_fontsize = 18; c_token++; break;
+        case LMPNG_POINTSCALE:
+            c_token++;
+            if (!END_OF_COMMAND) (void)real_expression();
+            break;
+        default: {
+            double sz;
+            if (sscanf(gp_input_line + token[c_token].start_index, "%lf", &sz) == 1 && sz > 0 && sz < 999) {
+                LM.default_fontsize = sz;
+                c_token++;
+                break;
+            }
+            int_error(c_token, "unrecognized terminal option");
+        }
+        }
+    }
+
+    if (LM.monochrome) term->flags |= TERM_MONOCHROME;
+    if (LM.enhanced) term->put_text = LMPNG_put_text; else term->put_text = LMPNG_put_text_plain;
+    if (LM.enhanced) term->flags |= TERM_ENHANCED_TEXT; else term->flags &= ~TERM_ENHANCED_TEXT;
+
+    LMPNG_apply_size();
+    LM.font = LM.default_font;
+    LM.fontname = LM.default_fontname;
+    LM.fontsize = LM.default_fontsize;
+    LMPNG_apply_font_metrics();
+
+    sprintf(term_options, "size %d,%d ", LM.opt_width, LM.opt_height);
+    strcat(term_options, LM.enhanced ? "enhanced " : "noenhanced ");
+    strcat(term_options, LM.monochrome ? "monochrome " : "color ");
+    if (LM.transparent) strcat(term_options, "transparent ");
+    if (LM.crop) strcat(term_options, "crop ");
+    strcat(term_options, LM.cap_round == 0 ? "butt " : LM.cap_round == 1 ? "rounded " : "square ");
+    if (LM.lw_factor != 1.0) sprintf(term_options + strlen(term_options), "linewidth %.1f ", LM.lw_factor);
+    if (LM.dash_factor != 1.0) sprintf(term_options + strlen(term_options), "dashlength %.1f ", LM.dash_factor);
+    if (LM.bg_set) sprintf(term_options + strlen(term_options), "background \"#%06x\" ", LM.bg);
+    if (LM.fontscale != 1.0) sprintf(term_options + strlen(term_options), "fontscale %.1f ", LM.fontscale);
+    if (strlen(term_options) + strlen(LM.default_fontname) < sizeof(term_options) - 32)
+        sprintf(term_options + strlen(term_options), "font \"%s,%g\"", LM.default_fontname, LM.default_fontsize);
+}
+
+TERM_PUBLIC void
+LMPNG_init(void)
+{
+    LM.lt = LT_BLACK;
+    LM.lw = 1.0;
+    LM.opacity = 1.0;
+    LM.rgb = 0;
+    LM.ndash = 0;
+    LM.axis_dash = 0;
+    LM.angle = 0;
+    LM.just = LEFT;
+    LM.npath = 0;
+}
+
+TERM_PUBLIC void
+LMPNG_reset(void)
+{
+    if (LM.img) { lmr_destroy(LM.img); LM.img = NULL; }
+    free(LM.path);
+    LM.path = NULL;
+    LM.npath = 0;
+}
+
+TERM_PUBLIC void
+LMPNG_graphics(void)
+{
+    unsigned bg;
+    if (LM.img) lmr_destroy(LM.img);
+    LM.width = LM.opt_width;
+    LM.height = LM.opt_height;
+    bg = LM.transparent ? 0x00ffffffu : (0xff000000u | LM.bg);
+    LM.img = lmr_create(LM.width, LM.height, bg);
+    if (!LM.img) int_error(NO_CARET, "png: cannot allocate %dx%d canvas", LM.width, LM.height);
+    LM.npath = 0;
+    LM.have_last = 0;
+    LM.lt = LT_BLACK;
+    LM.rgb = 0;
+    LM.opacity = 1.0;
+    LM.ndash = 0;
+    LM.axis_dash = 0;
+    LM.font = LM.default_font;
+    LM.fontsize = LM.default_fontsize;
+}
+
+TERM_PUBLIC void
+LMPNG_text(void)
+{
+    lmr *out;
+    LMPNG_flush_path();
+    if (!LM.img) return;
+    out = LM.img;
+    if (LM.crop) {
+        int x0, y0, x1, y1;
+        unsigned bg = LM.transparent ? 0x00ffffffu : (0xff000000u | LM.bg);
+        if (lmr_content_bbox(LM.img, bg, &x0, &y0, &x1, &y1)) {
+            lmr *c = lmr_crop(LM.img, x0, y0, x1, y1);
+            if (c) out = c;
+        }
+    }
+    if (lmr_write_png(out, gpoutfile) != 0)
+        int_warn(NO_CARET, "png: error writing output");
+    fflush(gpoutfile);
+    if (out != LM.img) lmr_destroy(out);
+    lmr_destroy(LM.img);
+    LM.img = NULL;
+}
+
+/* ------------------------------------------------------------ lines */
+
+TERM_PUBLIC void
+LMPNG_move(unsigned int x, unsigned int y)
+{
+    if (LM.have_last && LM.npath >= 1 && LM.lastx == x && LM.lasty == y) return;
+    LMPNG_flush_path();
+    LM.lastx = x; LM.lasty = y; LM.have_last = 1;
+}
+
+TERM_PUBLIC void
+LMPNG_vector(unsigned int x, unsigned int y)
+{
+    if (!LM.img) return;
+    if (LM.npath == 0) {
+        if (!LM.have_last) { LM.lastx = x; LM.lasty = y; LM.have_last = 1; }
+        LM.cappath = LM.cap_round;
+        LMPNG_path_add(LMX(LM.lastx), LMY(LM.lasty));
+    }
+    LMPNG_path_add(LMX(x), LMY(y));
+    LM.lastx = x; LM.lasty = y;
+}
+
+TERM_PUBLIC void
+LMPNG_linetype(int lt)
+{
+    LMPNG_flush_path();
+    LM.lt = lt;
+    LM.axis_dash = (lt == LT_AXIS);
+    if (lt == LT_AXIS && LM.monochrome) LM.rgb = 0;
+    LM.rgb = LMPNG_pen_rgb(lt);
+    if (lt == LT_AXIS) LM.rgb = 0x000000;
+    LM.opacity = 1.0;
+    if (lt == LT_SOLID || lt >= 0) {
+        if (lt == LT_SOLID) LM.ndash = 0;
+    }
+}
+
+TERM_PUBLIC void
+LMPNG_dashtype(int type, t_dashtype *custom)
+{
+    static const double defaults[5][7] = {
+        {0}, {5, 8}, {2, 4}, {8, 4, 2, 4}, {9, 4, 1, 4, 1, 4}
+    };
+    double scale = LM.lw * LM.lw_factor * LM.dash_factor * 0.5;
+    int j;
+    LMPNG_flush_path();
+    LM.ndash = 0;
+    switch (type) {
+    case DASHTYPE_SOLID:
+    case DASHTYPE_AXIS:
+        break;
+    case DASHTYPE_CUSTOM:
+        if (custom) {
+            for (j = 0; j < 8 && custom->pattern[j] > 0; j++)
+                LM.dash[LM.ndash++] = custom->pattern[j] * scale;
+            if (LM.ndash & 1) { LM.dash[LM.ndash] = LM.dash[LM.ndash - 1]; LM.ndash++; }
+        }
+        break;
+    default: {
+        int d = type % 5;
+        if (d <= 0) break;
+        for (j = 0; j < 7 && defaults[d][j] > 0; j++)
+            LM.dash[LM.ndash++] = defaults[d][j] * scale;
+        break;
+    }
+    }
+}
