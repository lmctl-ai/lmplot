+TERM_PUBLIC void
+LMPNG_set_color(t_colorspec *colorspec)
+{
+    LMPNG_flush_path();
+    switch (colorspec->type) {
+    case TC_LT:
+        LM.rgb = LMPNG_pen_rgb(colorspec->lt);
+        LM.opacity = 1.0;
+        break;
+    case TC_RGB:
+        LM.rgb = colorspec->lt & 0xffffff;
+        LM.opacity = 1.0 - (double)((colorspec->lt >> 24) & 0xff) / 255.0;
+        break;
+    case TC_FRAC:
+    case TC_Z:
+    case TC_CB:
+        LM.rgb = rgb_from_colorspec(colorspec) & 0xffffff;
+        LM.opacity = 1.0;
+        break;
+    default:
+        break;
+    }
+}
