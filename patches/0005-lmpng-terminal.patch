+/* ------------------------------------------------------------ fills */
+
+/* An axis-aligned rectangle (boxes, bars) is filled crisply so its edges land on pixel boundaries. */
+static int
+LMPNG_is_rect(const double *xy, int n)
+{
+    if (n == 5 && xy[0] == xy[8] && xy[1] == xy[9]) n = 4;
+    if (n != 4) return 0;
+    return (xy[0] == xy[2] && xy[3] == xy[5] && xy[4] == xy[6] && xy[7] == xy[1])
+        || (xy[1] == xy[3] && xy[2] == xy[4] && xy[5] == xy[7] && xy[6] == xy[0]);
+}
+
+TERM_PUBLIC void
+LMPNG_layer(t_termlayer layer)
+{
+    switch (layer) {
+    case TERM_LAYER_BEGIN_PM3D_MAP:
+    case TERM_LAYER_BEGIN_PM3D_FLUSH:
+        LM.crisp++;
+        break;
+    case TERM_LAYER_END_PM3D_MAP:
+    case TERM_LAYER_END_PM3D_FLUSH:
+        if (LM.crisp > 0) LM.crisp--;
+        break;
+    case TERM_LAYER_RESET:
+        LM.crisp = 0;
+        break;
+    default:
+        break;
+    }
+}
+
+TERM_PUBLIC void
+LMPNG_filled_polygon(int points, gpiPoint *corners)
+{
+    int fillpar = corners->style >> 4, style = corners->style & 0xf, i;
+    double *xy;
+    unsigned argb;
+    if (!LM.img || points < 3) return;
+    LMPNG_flush_path();
+    xy = (double *)gp_alloc(sizeof(double) * 2 * points, "lmpng polygon");
+    for (i = 0; i < points; i++) {
+        xy[2 * i] = LMX(corners[i].x);
+        xy[2 * i + 1] = LMY(corners[i].y);
+    }
+    switch (style) {
+    case FS_EMPTY:
+        if (LMPNG_is_rect(xy, points))
+            lmr_fill_polygon_crisp(LM.img, xy, points, LM.transparent ? 0x00ffffffu : (0xff000000u | LM.bg));
+        else
+            lmr_fill_polygon(LM.img, xy, points, LM.transparent ? 0x00ffffffu : (0xff000000u | LM.bg));
+        break;
+    case FS_PATTERN:
+    case FS_TRANSPARENT_PATTERN:
+        lmr_fill_polygon_pattern(LM.img, xy, points, LMPNG_argb(),
+                                 style == FS_PATTERN ? (0xff000000u | LM.bg) : 0u, fillpar % 10);
+        break;
+    case FS_SOLID:
+    case FS_TRANSPARENT_SOLID:
+    default: {
+        double op = LM.opacity;
+        if (op >= 1.0 && fillpar >= 0 && fillpar < 100) {
+            /* "fillstyle solid <density>": blend toward white; transparent variant keeps alpha */
+            if (style == FS_TRANSPARENT_SOLID) op = fillpar * 0.01;
+            else {
+                unsigned r = (LM.rgb >> 16) & 255, g = (LM.rgb >> 8) & 255, b = LM.rgb & 255;
+                double f = fillpar * 0.01;
+                r = (unsigned)(255 - (255 - (int)r) * f + 0.5);
+                g = (unsigned)(255 - (255 - (int)g) * f + 0.5);
+                b = (unsigned)(255 - (255 - (int)b) * f + 0.5);
+                argb = 0xff000000u | (r << 16) | (g << 8) | b;
+                if (LM.crisp > 0 || LMPNG_is_rect(xy, points)) lmr_fill_polygon_crisp(LM.img, xy, points, argb);
+                else lmr_fill_polygon(LM.img, xy, points, argb);
+                free(xy);
+                return;
+            }
+        }
+        argb = ((unsigned)(op * 255.0 + 0.5) << 24) | (LM.rgb & 0xffffff);
+        if (LM.crisp > 0 || LMPNG_is_rect(xy, points)) lmr_fill_polygon_crisp(LM.img, xy, points, argb);
+        else lmr_fill_polygon(LM.img, xy, points, argb);
+        break;
+    }
+    }
+    free(xy);
+}
+
+TERM_PUBLIC void
+LMPNG_fillbox(int style, unsigned int x, unsigned int y, unsigned int w, unsigned int h)
+{
+    gpiPoint c[4];
+    c[0].x = x;     c[0].y = y;
+    c[1].x = x + w; c[1].y = y;
+    c[2].x = x + w; c[2].y = y + h;
+    c[3].x = x;     c[3].y = y + h;
+    c[0].style = style;
+    LMPNG_filled_polygon(4, c);
+}
+
+TERM_PUBLIC void
+LMPNG_image(unsigned int m, unsigned int n, coordval *image, gpiPoint *corner, t_imagecolor color_mode)
+{
+    unsigned *pix;
+    unsigned i, j;
+    double x0, y0, x1, y1;
+    if (!LM.img || m == 0 || n == 0) return;
+    LMPNG_flush_path();
+    pix = (unsigned *)gp_alloc(sizeof(unsigned) * m * n, "lmpng image");
+    for (j = 0; j < n; j++) {
+        for (i = 0; i < m; i++) {
+            unsigned a = 255, r, g, b;
+            if (color_mode == IC_PALETTE) {
+                double v = *image++;
+                if (isnan(v)) { pix[j * m + i] = 0; continue; }
+                {
+                    unsigned rgb = rgb_from_gray(v);
+                    r = (rgb >> 16) & 255; g = (rgb >> 8) & 255; b = rgb & 255;
+                }
+            } else {
+                rgb_color c1;
+                rgb255_color c255;
+                c1.r = *image++; c1.g = *image++; c1.b = *image++;
+                if (color_mode == IC_RGBA) a = (unsigned)(*image++ + 0.5);
+                if (a > 255) a = 255;
+                rgb255_from_rgb1(c1, &c255);
+                r = c255.r; g = c255.g; b = c255.b;
+            }
+            pix[j * m + i] = (a << 24) | (r << 16) | (g << 8) | b;
+        }
+    }
+    /* corner[0] top-left, corner[1] bottom-right (terminal coords, y up) */
+    x0 = (double)corner[0].x; y0 = LM.height - 1 - (double)corner[0].y + 1.0;
+    x1 = (double)corner[1].x; 
+    {
+        double yb = LM.height - 1 - (double)corner[1].y + 1.0;
+        /* image box in device space: top-left (x0, top), bottom-right (x1, bottom) */
+        double top = y0 < yb ? y0 : yb, bottom = y0 < yb ? yb : y0;
+        (void)bottom;
+        lmr_draw_image(LM.img, pix, (int)m, (int)n, x0, y0, x1, y0, x0, yb);
+        (void)top;
+    }
+    free(pix);
+}
+
+/* ------------------------------------------------------------ points */
+
+static void
+LMPNG_stroke_pts(const double *xy, int n, double w)
+{
+    lmr_stroke(LM.img, xy, n, w, LMPNG_argb(), LMR_CAP_BUTT, LMR_JOIN_MITER, NULL, 0);
+}
+
+TERM_PUBLIC void
+LMPNG_point(unsigned int x, unsigned int y, int number)
+{
+    double cx = LMX(x), cy = LMY(y);
+    double s = term_pointsize * term->h_tic / 2.0 * 1.0;
+    double w = LM.lw * LM.lw_factor;
+    double p[12];
+    int k, i;
+    if (!LM.img) return;
+    LMPNG_flush_path();
+    if (number < 0) { /* dot */
+        double r = 0.5 * (w > 1 ? w : 1);
+        double sq[8] = { cx - r, cy - r, cx + r, cy - r, cx + r, cy + r, cx - r, cy + r };
+        lmr_fill_polygon(LM.img, sq, 4, LMPNG_argb());
+        return;
+    }
+    if (s < 1.0) s = 1.0;
+    k = number % 15;
+    switch (k) {
+    case 0: /* plus */
+        p[0] = cx - s; p[1] = cy; p[2] = cx + s; p[3] = cy; LMPNG_stroke_pts(p, 2, w);
+        p[0] = cx; p[1] = cy - s; p[2] = cx; p[3] = cy + s; LMPNG_stroke_pts(p, 2, w);
+        break;
+    case 1: /* x */
+        p[0] = cx - s; p[1] = cy - s; p[2] = cx + s; p[3] = cy + s; LMPNG_stroke_pts(p, 2, w);
+        p[0] = cx - s; p[1] = cy + s; p[2] = cx + s; p[3] = cy - s; LMPNG_stroke_pts(p, 2, w);
+        break;
+    case 2: /* star */
+        p[0] = cx - s; p[1] = cy; p[2] = cx + s; p[3] = cy; LMPNG_stroke_pts(p, 2, w);
+        p[0] = cx; p[1] = cy - s; p[2] = cx; p[3] = cy + s; LMPNG_stroke_pts(p, 2, w);
+        p[0] = cx - s; p[1] = cy - s; p[2] = cx + s; p[3] = cy + s; LMPNG_stroke_pts(p, 2, w);
+        p[0] = cx - s; p[1] = cy + s; p[2] = cx + s; p[3] = cy - s; LMPNG_stroke_pts(p, 2, w);
+        break;
+    case 3: case 4: { /* box, filled box */
+        double sq[10] = { cx - s, cy - s, cx + s, cy - s, cx + s, cy + s, cx - s, cy + s, cx - s, cy - s };
+        if (k == 4) lmr_fill_polygon(LM.img, sq, 4, LMPNG_argb());
+        else LMPNG_stroke_pts(sq, 5, w);
+        break;
+    }
+    case 5: case 6: { /* circle, filled circle */
+        double c[66];
+        int n = 24;
+        for (i = 0; i < n; i++) { c[2 * i] = cx + s * cos(2 * M_PI * i / n); c[2 * i + 1] = cy + s * sin(2 * M_PI * i / n); }
+        if (k == 6) lmr_fill_polygon(LM.img, c, n, LMPNG_argb());
+        else { c[2 * n] = c[0]; c[2 * n + 1] = c[1]; lmr_stroke(LM.img, c, n + 1, w, LMPNG_argb(), LMR_CAP_BUTT, LMR_JOIN_ROUND, NULL, 0); }
+        break;
+    }
+    case 7: case 8: case 9: case 10: { /* triangles: up, filled up, down, filled down */
+        double d = (k >= 9) ? -1.0 : 1.0;
+        double t[8] = { cx, cy - d * 1.33 * s, cx - 1.33 * s, cy + d * 0.67 * s, cx + 1.33 * s, cy + d * 0.67 * s, cx, cy - d * 1.33 * s };
+        if (k == 8 || k == 10) lmr_fill_polygon(LM.img, t, 3, LMPNG_argb());
+        else LMPNG_stroke_pts(t, 4, w);
+        break;
+    }
+    case 11: case 12: { /* diamond, filled diamond */
+        double d[10] = { cx, cy - 1.41 * s, cx + 1.41 * s, cy, cx, cy + 1.41 * s, cx - 1.41 * s, cy, cx, cy - 1.41 * s };
+        if (k == 12) lmr_fill_polygon(LM.img, d, 4, LMPNG_argb());
+        else LMPNG_stroke_pts(d, 5, w);
+        break;
+    }
+    case 13: case 14: { /* pentagon, filled pentagon */
+        double pg[12] = { cx, cy - 1.33 * s, cx + 1.265 * s, cy - 0.411 * s, cx + 0.782 * s, cy + 1.067 * s,
+                          cx - 0.782 * s, cy + 1.076 * s, cx - 1.265 * s, cy - 0.411 * s, cx, cy - 1.33 * s };
+        if (k == 14) lmr_fill_polygon(LM.img, pg, 5, LMPNG_argb());
+        else LMPNG_stroke_pts(pg, 6, w);
+        break;
+    }
+    }
+}
+
+/* ------------------------------------------------------------ text */
+
+TERM_PUBLIC int
+LMPNG_text_angle(float ang)
+{
+    LM.angle = ang;
+    return TRUE;
+}
+
+TERM_PUBLIC int
+LMPNG_justify_text(enum JUSTIFY mode)
+{
+    LM.just = mode;
+    return TRUE;
+}
+
+TERM_PUBLIC int
+LMPNG_set_font(const char *font)
+{
+    if (!font || !*font) {
+        LM.font = LM.default_font;
+        LM.fontname = LM.default_fontname;
+        LM.fontsize = LM.default_fontsize;
+    } else {
+        char *name = NULL;
+        lmr_font f = LM.font;
+        double size = LM.fontsize;
+        if (*font == ',') {
+            /* size only */
+            double sz;
+            if (sscanf(font + 1, "%lf", &sz) == 1 && sz > 0) size = sz;
+        } else {
+            LMPNG_parse_font(font, &name, &size, &f, 0);
+            LM.font = f;
+            free(name);
+        }
+        LM.fontsize = size;
+    }
+    return TRUE;
+}
+
+static void
+LMPNG_note_box(double x0, double y0, double x1, double y1)
+{
+    if (!LM.box_valid) {
+        LM.box[0] = x0; LM.box[1] = y0; LM.box[2] = x1; LM.box[3] = y1;
+        LM.box_valid = 1;
+        return;
+    }
+    if (x0 < LM.box[0]) LM.box[0] = x0;
+    if (y0 < LM.box[1]) LM.box[1] = y0;
+    if (x1 > LM.box[2]) LM.box[2] = x1;
+    if (y1 > LM.box[3]) LM.box[3] = y1;
+}
+
+/* Draw one run of text with its baseline origin at device (bx,by). Returns the advance. */
+static double
+LMPNG_draw_run(const char *s, lmr_font f, double px, double bx, double by, int show)
+{
+    double w = lmr_text_width(f, px, s);
+    double a = LM.angle * M_PI / 180.0;
+    if (show) lmr_text_draw(LM.img, f, px, s, bx, by, a, LMPNG_argb());
+    if (show) {
+        double asc, desc, cs = cos(a), sn = sin(a);
+        double ux = -sn, uy = -cs; /* text "up" in device coords */
+        double x[4], y[4];
+        int i;
+        lmr_font_metrics(f, px, &asc, &desc);
+        x[0] = bx + asc * ux;         y[0] = by + asc * uy;
+        x[1] = bx - desc * ux;        y[1] = by - desc * uy;
+        x[2] = bx + w * cs + asc * ux; y[2] = by - w * sn + asc * uy;
+        x[3] = bx + w * cs - desc * ux; y[3] = by - w * sn - desc * uy;
+        for (i = 0; i < 4; i++) LMPNG_note_box(x[i], y[i], x[i], y[i]);
+    }
+    return w;
+}
+
+/* Device-space baseline origin for a string anchored (vertically centered) at terminal (x,y). */
+static void
+LMPNG_anchor(unsigned int x, unsigned int y, double px, double *bx, double *by)
+{
+    double a = LM.angle * M_PI / 180.0;
+    double down = 0.36 * px; /* centre of digit height below the baseline */
+    *bx = LMX(x) + sin(a) * down;
+    *by = LMY(y) + cos(a) * down;
+}
+
+TERM_PUBLIC void
+LMPNG_put_text_plain(unsigned int x, unsigned int y, const char *str)
+{
+    double px = LM.fontsize * LM.fontscale * LMPNG_PX_PER_PT;
+    double bx, by, w, a = LM.angle * M_PI / 180.0;
+    if (!LM.img || !*str) return;
+    LMPNG_flush_path();
+    LMPNG_anchor(x, y, px, &bx, &by);
+    w = lmr_text_width(LM.font, px, str);
+    if (LM.just == CENTRE) { bx -= w / 2 * cos(a); by += w / 2 * sin(a); }
+    else if (LM.just == RIGHT) { bx -= w * cos(a); by += w * sin(a); }
+    LMPNG_draw_run(str, LM.font, px, bx, by, 1);
+}
+
+TERM_PUBLIC void
+LMPNG_enhanced_open(char *fontname, double fontsize, double base, TBOOLEAN widthflag, TBOOLEAN showflag, int overprint)
+{
+    if (overprint == 3) { LM.save_x = LM.pen_x; LM.save_y = LM.pen_y; return; }
+    if (overprint == 4) { LM.pen_x = LM.save_x; LM.pen_y = LM.save_y; return; }
+    if (!LM.enh_open) {
+        LM.enh_open = 1;
+        enhanced_cur_text = &enhanced_text[0];
+        LM.enh_font = fontname;
+        LM.enh_size = fontsize;
+        LM.enh_base = base;
+        LM.enh_show = showflag;
+        LM.enh_overprint = overprint;
+        LM.enh_widthflag = widthflag;
+    }
+}
+
+TERM_PUBLIC void
+LMPNG_enhanced_flush(void)
+{
+    lmr_font f = LM.font;
+    double size = LM.enh_size * LMPNG_PX_PER_PT, a = LM.angle * M_PI / 180.0, cs = cos(a), sn = sin(a), w;
+    double bx, by;
+    char *fontcopy = NULL;
+    if (!LM.enh_open) return;
+    LM.enh_open = 0;
+    *enhanced_cur_text = '\0';
+    if (LM.enh_font && *LM.enh_font) {
+        double dummy = 0;
+        LMPNG_parse_font(LM.enh_font, &fontcopy, &dummy, &f, 0);
+        free(fontcopy);
+        /* inherit bold/italic only when the name did not ask for them but the parent had them */
+    }
+    bx = LM.pen_x - sn * LM.enh_base * LMPNG_PX_PER_PT;
+    by = LM.pen_y - cs * LM.enh_base * LMPNG_PX_PER_PT;
+    w = LMPNG_draw_run(enhanced_text, f, size, bx, by, LM.enh_show && !LM.enh_sizeonly);
+    if (LM.enh_overprint == 1) {
+        LM.pen_x += w / 2 * cs;
+        LM.pen_y -= w / 2 * sn;
+    } else if (LM.enh_widthflag) {
+        LM.pen_x += w * cs;
+        LM.pen_y -= w * sn;
+    }
+}
+
+TERM_PUBLIC void
+LMPNG_put_text(unsigned int x, unsigned int y, const char *str)
+{
+    char *original = (char *)str;
+    char *fontcopy;
+    double px = LM.fontsize * LM.fontscale * LMPNG_PX_PER_PT, bx, by, a = LM.angle * M_PI / 180.0;
+    JUSTIFY just = LM.just;
+    if (!LM.img) return;
+    if (ignore_enhanced_text || !LM.enhanced || !*str || (!strpbrk(str, "{}^_@&~") && !contains_unicode(str))) {
+        LMPNG_put_text_plain(x, y, str);
+        return;
+    }
+    LMPNG_flush_path();
+    LMPNG_anchor(x, y, px, &bx, &by);
+
+    enhanced_fontscale = LM.fontscale;
+    strncpy(enhanced_escape_format, "&#x%2.2x;", sizeof(enhanced_escape_format));
+
+    LM.enh_open = 0;
+    LM.enh_show = 1;
+    LM.enh_overprint = 0;
+    LM.enh_sizeonly = (just == RIGHT || just == CENTRE);
+    LM.pen_x = bx;
+    LM.pen_y = by;
+
+    fontcopy = gp_strdup(LM.fontname ? LM.fontname : "Sans");
+    while (*(str = enhanced_recursion((char *)str, TRUE, fontcopy, LM.fontsize * LM.fontscale, 0.0, TRUE, TRUE, 0))) {
+        (term->enhanced_flush)();
+        enh_err_check(str);
+        if (!*++str) break;
+    }
+    (term->enhanced_flush)();
+    free(fontcopy);
+
+    if (LM.enh_sizeonly) {
+        /* second pass: draw, shifted back by the measured advance */
+        double adv = (LM.pen_x - bx) * cos(a) - (LM.pen_y - by) * sin(a);
+        double shift = (just == RIGHT) ? adv : adv / 2;
+        LM.enh_sizeonly = 0;
+        LM.pen_x = bx - shift * cos(a);
+        LM.pen_y = by + shift * sin(a);
+        str = original;
+        enhanced_fontscale = LM.fontscale;
+        LM.enh_open = 0;
+        fontcopy = gp_strdup(LM.fontname ? LM.fontname : "Sans");
+        while (*(str = enhanced_recursion((char *)str, TRUE, fontcopy, LM.fontsize * LM.fontscale, 0.0, TRUE, TRUE, 0))) {
+            (term->enhanced_flush)();
+            enh_err_check(str);
+            if (!*++str) break;
+        }
+        (term->enhanced_flush)();
+        free(fontcopy);
+    }
+}
+
+TERM_PUBLIC void
+LMPNG_boxed_text(unsigned int x, unsigned int y, int option)
+{
+    double mx = LM.box_xmargin, my = LM.box_ymargin;
+    double rect[10];
+    switch (option) {
+    case TEXTBOX_INIT:
+        LM.box_valid = 0;
+        (void)x; (void)y;
+        break;
+    case TEXTBOX_MARGINS:
+        LM.box_xmargin = 1.0 * (double)x / 100.0 * LM.fontsize * LM.fontscale * LMPNG_PX_PER_PT * 0.5;
+        LM.box_ymargin = 1.0 * (double)y / 100.0 * LM.fontsize * LM.fontscale * LMPNG_PX_PER_PT * 0.5;
+        break;
+    case TEXTBOX_OUTLINE:
+    case TEXTBOX_BACKGROUNDFILL:
+        if (!LM.box_valid || !LM.img) break;
+        rect[0] = LM.box[0] - mx; rect[1] = LM.box[1] - my;
+        rect[2] = LM.box[2] + mx; rect[3] = LM.box[1] - my;
+        rect[4] = LM.box[2] + mx; rect[5] = LM.box[3] + my;
+        rect[6] = LM.box[0] - mx; rect[7] = LM.box[3] + my;
+        rect[8] = rect[0]; rect[9] = rect[1];
+        if (option == TEXTBOX_OUTLINE)
+            lmr_stroke(LM.img, rect, 5, LM.lw * LM.lw_factor, LMPNG_argb(), LMR_CAP_BUTT, LMR_JOIN_MITER, NULL, 0);
+        else
+            lmr_fill_polygon(LM.img, rect, 4, LMPNG_argb());
+        break;
+    default:
+        break;
+    }
+}
