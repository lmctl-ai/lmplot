diff --git a/src/plot.h b/src/plot.h
index d22e392..0990bed 100644
--- a/src/plot.h
+++ b/src/plot.h
@@ -81,6 +81,13 @@ int ExecuteMacro(char *, int);
 
 void restrict_popen(void);
 
+/* lmplot --dry-run: when set, every file gnuplot would write (set output, set print, save,
+ * set table, the fit log) is reported on stderr and replaced by the null device, and pipes and
+ * shell commands are an error. Defined in cpp/lmplot_embed.inc. */
+#include <stdio.h>
+extern int lmplot_dry_run;
+FILE *lmplot_dry_fopen(const char *name, const char *mode);
+
 #ifdef GNUPLOT_HISTORY
 void cancel_history(void);
 #else
