diff --git a/src/term.c b/src/term.c
index 230e1b5..15823f0 100644
--- a/src/term.c
+++ b/src/term.c
@@ -303,6 +303,9 @@ static size_units parse_term_size(float *xsize, float *ysize, size_units def_uni
 static TBOOLEAN output_pipe_open = FALSE;
 #endif /* PIPES */
 
+static int lmplot_plots_in_output = 0;
+static TBOOLEAN lmplot_reopening_output = FALSE;
+
 static void
 term_close_output()
 {
@@ -336,6 +339,63 @@ term_close_output()
     gppsfile = NULL;
 }
 
+void
+lmplot_abort_output(void)
+{
+    char *bad = NULL;
+    term_graphics = FALSE;
+    if (multiplot)
+	multiplot_end();
+    if (term && term_initialised) {
+	(*term->reset) ();
+	term_initialised = FALSE;
+	gppsfile = NULL;
+    }
+    if (outstr && !lmplot_dry_run
+#if defined(PIPES)
+	&& !output_pipe_open
+#endif
+	&& strncmp(outstr, "/dev/", 5) != 0) {
+	bad = gp_strdup(outstr);
+    }
+    term_close_output();
+    lmplot_plots_in_output = 0;
+    if (bad) {
+	remove(bad);
+	free(bad);
+    }
+}
+
+int
+lmplot_finish_output(void)
+{
+    if (multiplot) {
+	lmplot_abort_output();
+	return 1;
+    }
+    if (outstr) {
+	int write_err = 0;
+	if (lmplot_plots_in_output == 0) {
+	    lmplot_abort_output();
+	    return 2;
+	}
+	if (gpoutfile && gpoutfile != stdout && gpoutfile != stderr) {
+	    if (fflush(gpoutfile) != 0 || ferror(gpoutfile))
+		write_err = 1;
+	}
+	if (term && term_initialised) {
+	    (*term->reset) ();
+	    term_initialised = FALSE;
+	    gppsfile = NULL;
+	}
+	term_close_output();
+	lmplot_plots_in_output = 0;
+	if (write_err)
+	    return 3;
+    }
+    return 0;
+}
+
